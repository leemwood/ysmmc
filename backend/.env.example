# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=ysmmc

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRE_HOURS=24
JWT_REFRESH_EXPIRE_DAYS=7

# Server Configuration
SERVER_PORT=8080
GIN_MODE=debug

# File Upload Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=104857600
MAX_DISK_USAGE=90
ENABLE_DATE_PARTITION=true

# SMTP Configuration (Optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=YSM模型站 <your_email@example.com>

# Frontend URL
FRONTEND_URL=http://localhost:5173

# CORS Allowed Origins (comma-separated, supports *.domain.com for subdomains)
# Example: http://localhost:5173,https://test.ysmmc.cn,https://ysmmc.cn,*.ysmmc.cn
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# NexusMC OAuth2 / Site API (credentials not yet issued; placeholders only)
NEXUSMC_OAUTH_BASE_URL=https://www.nexusmc.cn/api/oauth2
NEXUSMC_SITE_API_BASE_URL=https://www.nexusmc.cn/api/site/v1
NEXUSMC_OAUTH_CLIENT_ID=your_nexusmc_client_id
NEXUSMC_OAUTH_CLIENT_SECRET=your_nexusmc_client_secret
NEXUSMC_OAUTH_REDIRECT_URI=http://localhost:8080/api/auth/nexusmc/callback
NEXUSMC_SITE_API_KEY=your_nexusmc_site_api_key
